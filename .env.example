# 요청 사이 랜덤 대기 시간(초) - 공급사 사이트 봇 차단 회피용
AUTO_INVOICE_DELAY_MIN=1.5
AUTO_INVOICE_DELAY_MAX=4.0

# 동시에 조회할 공급사 수 (기본 4). 사이트끼리는 서로 상관이 없어 같이 돌려도
# 되고, 같은 사이트 안에서는 그대로 한 건씩 순서대로 봅니다. 브라우저를 그만큼
# 동시에 띄우니 PC가 버거우면 줄이고, 1로 두면 예전처럼 한 사이트씩 돕니다.
AUTO_INVOICE_WORKERS=8

# 롯데온 로그인 아이디/비밀번호 - 세션 만료 시 사람 개입 없이 완전 자동으로
# 재로그인합니다(SSG/더현대/NS홈쇼핑/11번가/옥션과 동일한 방식 - 로그인 페이지에
# 캡차도 키보드보안도 없고, 로그인 API가 봇 차단에 걸리지 않는 것을 확인했습니다).
# LOTTEON_PW를 비워두면 예전처럼 브라우저 창에서 직접 로그인하는 방식으로
# 동작합니다(그 경우 아이디만 자동 입력됩니다).
LOTTEON_ID=
LOTTEON_PW=

# 지마켓 로그인 아이디/비밀번호 - 세션 만료 시 사람 개입 없이 완전 자동으로
# 재로그인합니다(옥션과 같은 이베이코리아 통합 로그인이라 동일한 방식 - 로그인
# 페이지에 봇 확인 화면이 뜨지 않고, 캡차 입력칸도 평소에는 숨겨져 있는 것을
# 확인했습니다). GMARKET_PW를 비워두면 예전처럼 브라우저 창에서 직접
# 로그인하는 방식으로 동작합니다(그 경우 아이디만 자동 입력됩니다).
GMARKET_ID=
GMARKET_PW=

# SSG.COM 로그인 아이디/비밀번호 (필수) - 다른 사이트와 달리 세션 만료 시
# 사람 개입 없이 완전 자동으로 재로그인하도록 만들어서, 비밀번호도 저장합니다.
SSG_ID=
SSG_PW=

# 네이버페이 로그인 아이디/비밀번호 (계정 2개 지원) - 세션 만료 시 사람 개입
# 없이 완전 자동으로 재로그인합니다.
# 이 사이트만 로그인할 때 크롬 창이 잠깐 뜹니다(계정마다 하나씩). 평소 쓰는
# 브라우저로 로그인하면 "보안을 위해 추가 확인" 캡차가 뜨는데, 크롬을 직접
# 띄워 CDP로 붙으면 캡차 없이 통과되기 때문입니다(2026-08-28 실측). 사람이
# 타이핑하거나 체크박스를 누를 일은 없고, 조회는 평소대로 headless로 합니다.
# 비밀번호를 비워두면 예전처럼 아이디만 자동 입력하고 사람이 직접 로그인합니다.
# 어느 계정에 주문 내역이 있는지 몰라도 되도록 조회 시 두 계정을 모두 확인합니다.
NAVER_ID=
NAVER_PW=
NAVER_ID2=
NAVER_PW2=

# 무신사 로그인 아이디/비밀번호 (계정 3개 지원) - 세션 만료 시 사람 개입 없이
# 완전 자동으로 재로그인합니다(롯데온/패션플러스/롯데아이몰과 동일한 방식).
# 최초 로그인도 scripts/musinsa_login_setup.py를 한 번 실행하면 3계정 모두
# 자동으로 처리됩니다 (무신사는 Cloudflare 때문에 크롬 쿠키
# 이식(import_chrome_session.py)이 통하지 않습니다).
# 어느 계정에 주문 내역이 있는지 몰라도 되도록 조회 시 세 계정을 모두 확인합니다.
# 로그인 실패가 반복되면 사이트가 봇 확인(reCAPTCHA)을 켜는데, 그때는 자동 로그인을
# 포기하고 직접 로그인하도록 안내합니다.
# 비밀번호를 비워두면 그 계정만 예전처럼 아이디만 자동 입력되고 비밀번호는 직접
# 입력하는 방식으로 동작합니다.
MUSINSA_ID=
MUSINSA_PW=
MUSINSA_ID2=
MUSINSA_PW2=
MUSINSA_ID3=
MUSINSA_PW3=

# 패션플러스 로그인 아이디/비밀번호 - 세션 만료 시 사람 개입 없이 완전 자동으로
# 재로그인합니다(SSG/더현대/NS홈쇼핑/11번가/옥션과 동일한 방식 - 로그인 페이지에
# reCAPTCHA/Turnstile 같은 봇 확인도 키보드보안도 없는 것을 확인했습니다).
# FASHIONPLUS_PW를 비워두면 예전처럼 아이디만 자동 입력되고 비밀번호는 직접
# 입력하는 방식으로 동작합니다.
FASHIONPLUS_ID=
FASHIONPLUS_PW=

# GSSHOP 로그인 아이디/비밀번호 - 세션 만료 시 사람 개입 없이 완전 자동으로
# 재로그인합니다. 로그인하는 동안에만 크롬 창이 잠깐 떴다가 닫힙니다
# (현대몰/CJ온스타일과 같습니다).
# 다만 이 사이트는 조건이 하나 더 있습니다(2026-08-29 실측): 로그인 폼의
# reCAPTCHA Enterprise가, 크롬을 직접 띄워 CDP로 붙는 것만으로는 부족하고
# **그 크롬 프로필이 구글에 로그인되어 있어야** 통과 점수(pass)를 줍니다.
# 구글 계정이 없는 프로필은 3번 시도해 3번 다 체크박스 요구(need)였고,
# 구글에 로그인시킨 뒤에는 3번 다 pass였습니다.
# 그래서 **최초 1회만** 아래를 실행해 그 프로필에 구글 로그인을 해두세요:
#     python scripts/setup_gsshop_login_profile.py
# (평범한 크롬 창이 뜹니다. 평소 쓰는 구글 계정으로 로그인하고 창을 닫으면
#  이어서 GSSHOP 점수까지 확인해줍니다. GSSHOP 계정과는 무관합니다.)
# 그 구글 로그인이 풀리면 예전처럼 체크박스가 뜨는데, 그때는 뜬 창에서 사람이
# 통과시켜도 되고(자동으로 이어집니다), 위 스크립트를 다시 실행해도 됩니다.
# --headless로 돌릴 때는 눌러줄 사람이 없다고 보고 기다리지 않습니다.
# GSSHOP_PW를 비워두면 아이디만 자동 입력되고 비밀번호는 직접 입력합니다.
GSSHOP_ID=
GSSHOP_PW=

# 롯데아이몰 로그인 아이디/비밀번호 - 세션 만료 시 사람 개입 없이 완전 자동으로
# 재로그인합니다(롯데온/패션플러스와 동일한 방식 - 로그인 페이지에 reCAPTCHA/Turnstile
# 같은 봇 확인도 키보드보안도 없는 것을 확인했습니다). 단 이 사이트는 headless
# 브라우저의 로그인 페이지 접근을 403으로 막기 때문에, 세션이 끊긴 상태에서는
# --headless 없이 실행해야 자동 로그인이 됩니다.
# 로그인 실패가 반복되면 사이트가 보안문자(캡차)를 요구하는데, 그때는 자동 로그인을
# 포기하고 직접 로그인하도록 안내합니다.
# LOTTEIMALL_PW를 비워두면 예전처럼 아이디만 자동 입력되고 비밀번호는 직접
# 입력하는 방식으로 동작합니다.
LOTTEIMALL_ID=
LOTTEIMALL_PW=

# 현대몰(Hmall) 로그인 아이디/비밀번호 - 세션 만료 시 사람 개입 없이 자동으로
# 재로그인합니다. 다만 이 사이트만 로그인 방식이 다릅니다(2026-08-28 실측):
# 로그인 폼의 reCAPTCHA v3가 "설치된 진짜 크롬 + 계속 재사용되는 프로필"에만
# 통과 점수를 주기 때문에(번들 브라우저는 0.4, 진짜 크롬 headless는 0.1, 진짜
# 크롬 창은 0.8 - 통과선은 0.5), 로그인할 때만 크롬 창이 잠깐 떴다가 닫힙니다.
# 사람이 타이핑할 일은 없고, 조회는 지금까지처럼 창 없이 진행됩니다. 로그인
# 프로필은 auth/chrome_profile_hmall에 쌓이니 지우지 마세요(쓸수록 점수에 유리).
# 계정은 더현대(THEHYUNDAI_ID/PW)와 같은 통합회원이라 보통 같은 값을 넣으면 됩니다
# (단 쿠키는 공유되지 않아 사이트별로 각각 로그인합니다).
# HMALL_PW를 비워두면 예전처럼 아이디만 자동 입력되고 비밀번호는 직접 입력합니다.
HMALL_ID=
HMALL_PW=

# 더현대(hi.thehyundai.com) 로그인 아이디/비밀번호 (필수) - 다른 사이트와 달리 세션
# 만료 시 사람 개입 없이 완전 자동으로 재로그인하도록 만들어서, 비밀번호도
# 저장합니다(SSG와 동일한 방식 - reCAPTCHA 등에 막히지 않는 것을 확인했습니다).
THEHYUNDAI_ID=
THEHYUNDAI_PW=

# NS홈쇼핑(m.nsmall.com) 로그인 아이디/비밀번호 (필수) - 다른 사이트와 달리 세션
# 만료 시 사람 개입 없이 완전 자동으로 재로그인하도록 만들어서, 비밀번호도
# 저장합니다(SSG/더현대와 동일한 방식 - reCAPTCHA 등에 막히지 않는 것을 확인했습니다).
NSMALL_ID=
NSMALL_PW=

# 11번가(buy.11st.co.kr) 로그인 아이디/비밀번호 (필수) - 다른 사이트와 달리 세션
# 만료 시 사람 개입 없이 완전 자동으로 재로그인하도록 만들어서, 비밀번호도
# 저장합니다(SSG/더현대/NS홈쇼핑과 동일한 방식 - 캡차 등에 막히지 않는 것을
# 확인했습니다). 최초 1회 자동 로그인 후에는 auth/elevenst_state.json에 저장된
# 쿠키만으로 바로 조회됩니다.
ELEVENST_ID=
ELEVENST_PW=

# 옥션(escrow.auction.co.kr) 로그인 아이디/비밀번호 (필수) - 다른 사이트와 달리 세션
# 만료 시 사람 개입 없이 완전 자동으로 재로그인하도록 만들어서, 비밀번호도
# 저장합니다(SSG/더현대/NS홈쇼핑/11번가와 동일한 방식 - 캡차 등에 막히지 않는 것을
# 확인했습니다). 최초 1회 자동 로그인 후에는 auth/auction_state.json에 저장된
# 쿠키만으로 바로 조회됩니다.
AUCTION_ID=
AUCTION_PW=

# CJ온스타일(base.cjonstyle.com) 로그인 아이디/비밀번호 - 세션 만료 시 사람 개입
# 없이 완전 자동으로 재로그인합니다. 다만 로그인 폼에 Cloudflare Turnstile
# ("사람인지 확인")이 걸려 있어서, **로그인하는 동안에만 크롬 창이 잠깐 떴다가
# 닫힙니다**(현대몰과 같습니다). Playwright가 띄운 브라우저에서는 Turnstile이
# 영영 통과되지 않고, 크롬을 그냥 실행해서 디버깅 포트로 붙었을 때만 3초 만에
# 저절로 통과되기 때문입니다 - 사람이 체크박스를 누르거나 타이핑할 일은 없고,
# 조회는 평소처럼 창 없이 진행됩니다.
# CJONSTYLE_PW를 비워두면 아이디만 자동 입력되고 비밀번호는 직접 입력하는 방식으로
# 동작합니다.
CJONSTYLE_ID=
CJONSTYLE_PW=

# AK플라자(디지털AK플라자, digital-akplaza.com) 로그인 아이디/비밀번호 - 세션 만료 시
# 사람 개입 없이 완전 자동으로 재로그인합니다(패션플러스/롯데온과 동일한 방식 -
# 로그인 페이지에 reCAPTCHA/Turnstile 같은 봇 확인도 키보드보안도 없고 headless로도
# 정상 동작하는 것을 확인했습니다).
# AKPLAZA_PW를 비워두면 아이디만 자동 입력되고 비밀번호는 직접 입력하는 방식으로 동작합니다.
AKPLAZA_ID=
AKPLAZA_PW=

# SSF샵(www.ssfshop.com) 로그인 아이디/비밀번호 - 세션 만료 시 사람 개입 없이 완전
# 자동으로 재로그인합니다(SSG/더현대와 동일한 방식 - 봇 확인도 비밀번호 암호화도
# 없고 headless로도 정상 동작하는 것을 확인했습니다).
# 주의: 이 사이트는 **비밀번호가 5회 틀리면 계정이 잠깁니다**. 틀린 값을 넣어두면
# 실행할 때마다 한 번씩 실패가 쌓이므로, 값이 맞는지 확인하고 넣어주세요(로그인에
# 실패하면 사이트가 알려주는 남은 횟수가 실패 사유에 그대로 나옵니다).
SSFSHOP_ID=
SSFSHOP_PW=

# W컨셉(www.wconcept.co.kr) 로그인 아이디(이메일)/비밀번호 - 세션 만료 시 사람 개입
# 없이 자동으로 재로그인합니다. 다만 이 사이트는 로그인 폼에 reCAPTCHA
# Enterprise가 걸려 있어서, 현대몰(HMALL_PW)·CJ온스타일과 마찬가지로 **로그인하는
# 동안만 크롬 창이 잠깐 떴다가 닫힙니다**(설치된 진짜 크롬에서만 봇 확인을
# 통과합니다 - 번들 Chromium headless로 시도하면 점수 미달로 거부됩니다).
# 사람이 타이핑하거나 체크박스를 누를 일은 없고, 조회는 평소처럼 창 없이 진행됩니다.
# 주의: 봇 확인에 걸리면 사이트가 **30분 간 로그인을 제한**합니다("비정상적인 로그인
# 시도로 30분 간 로그인이 제한됩니다"). 그 경우 조회 사유에 그 문구가 그대로 나오며,
# 30분 뒤 다시 실행하면 됩니다.
WCONCEPT_ID=
WCONCEPT_PW=

# 포스티(posty.kr) 로그인 아이디(이메일)/비밀번호 - 세션 만료 시 사람 개입 없이 완전
# 자동으로 재로그인합니다. 창은 뜨지 않습니다(headless로 통과하는 것을 확인했습니다).
# 이 사이트는 로그인만 브라우저 화면을 거쳐야 합니다 - 로그인 API를 직접 부르면
# "잘못된 접근입니다"로 막히고(로그인 화면의 자바스크립트가 심는 fingerprint 쿠키가
# 필요합니다), 조회는 로그인 뒤 쿠키만 있으면 API 한 번으로 끝납니다.
# 한 번 로그인하면 쿠키가 auth/posty_state.json 에 저장되어 다음 실행부터는 바로 조회합니다.
POSTY_ID=
POSTY_PW=

# 29CM(www.29cm.co.kr) 로그인 아이디/비밀번호 - 세션 만료 시 사람 개입 없이 완전
# 자동으로 재로그인합니다. 창은 뜨지 않습니다(headless로 통과하는 것을 확인했습니다).
# 29CM는 무신사 통합계정 체계라, 어댑터가 29CM 자체 이메일 로그인이 아니라 로그인
# 화면의 "무신사 통합계정" 버튼을 거쳐(OAuth) 로그인합니다. 비워두면 같은 통합계정인
# MUSINSA_ID/MUSINSA_PW를 그대로 씁니다.
# 주의: 29CM 자체 이메일 로그인 폼에 이 통합계정을 넣으면 INVALID_CREDENTIALS로
# 거부되고 실패 횟수(5회 = 10분 잠금)까지 올라갑니다 - 직접 시도하지 마세요.
# 한 번 로그인하면 쿠키가 auth/29cm_state.json 에 저장되어 다음 실행부터는 바로 조회합니다.
29CM_ID=
29CM_PW=
