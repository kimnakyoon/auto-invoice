# 요청 사이 랜덤 대기 시간(초) - 공급사 사이트 봇 차단 회피용
AUTO_INVOICE_DELAY_MIN=1.5
AUTO_INVOICE_DELAY_MAX=4.0

# 롯데온 로그인 아이디 (선택) - 세션 만료로 재로그인이 필요할 때 아이디만 자동 입력됩니다.
# 비밀번호는 절대 저장/자동입력하지 않으며 매번 직접 입력해야 합니다.
LOTTEON_ID=

# 지마켓 로그인 아이디 (선택) - 세션 만료로 재로그인이 필요할 때 아이디만 자동 입력됩니다.
# 비밀번호는 절대 저장/자동입력하지 않으며 매번 직접 입력해야 합니다.
GMARKET_ID=

# SSG.COM 로그인 아이디/비밀번호 (필수) - 다른 사이트와 달리 세션 만료 시
# 사람 개입 없이 완전 자동으로 재로그인하도록 만들어서, 비밀번호도 저장합니다.
SSG_ID=
SSG_PW=

# 네이버페이 로그인 아이디 (계정 2개 지원, 선택) - 세션 만료로 재로그인이 필요할 때
# 아이디만 자동 입력됩니다. 비밀번호는 절대 저장/자동입력하지 않으며 매번 직접
# 입력해야 합니다 (네이버는 자동 비밀번호 입력을 감지해 보안 확인을 요구함).
# 어느 계정에 주문 내역이 있는지 몰라도 되도록 조회 시 두 계정을 모두 확인합니다.
NAVER_ID=
NAVER_ID2=

# 무신사 로그인 아이디 (계정 3개 지원, 선택) - 세션 만료로 재로그인이 필요할 때
# 아이디만 자동 입력됩니다. 비밀번호는 절대 저장/자동입력하지 않으며 매번 직접
# 입력해야 합니다. 최초 로그인은 scripts/musinsa_login_setup.py로 한 번에
# 3계정 모두 설정하는 걸 추천합니다 (무신사는 Cloudflare 때문에 크롬 쿠키
# 이식(import_chrome_session.py)이 통하지 않습니다).
# 어느 계정에 주문 내역이 있는지 몰라도 되도록 조회 시 세 계정을 모두 확인합니다.
MUSINSA_ID=
MUSINSA_ID2=
MUSINSA_ID3=

# 패션플러스 로그인 아이디 (선택) - 세션 만료로 재로그인이 필요할 때 아이디만 자동 입력됩니다.
# 비밀번호는 절대 저장/자동입력하지 않으며 매번 직접 입력해야 합니다.
FASHIONPLUS_ID=

# GSSHOP 로그인 아이디 (선택) - 세션 만료로 재로그인이 필요할 때 아이디만 자동 입력됩니다.
# 비밀번호는 절대 저장/자동입력하지 않으며 매번 직접 입력해야 합니다. 최초 로그인은
# scripts/import_chrome_session.py로 지금 크롬에 로그인된 세션을 그대로 가져오는 걸
# 추천합니다(이미 크롬에 로그인되어 있다면 이 프로그램에서 따로 로그인할 필요가 없습니다).
GSSHOP_ID=

# 롯데아이몰 로그인 아이디 (선택) - 세션 만료로 재로그인이 필요할 때 아이디만 자동 입력됩니다.
# 비밀번호는 절대 저장/자동입력하지 않으며 매번 직접 입력해야 합니다.
LOTTEIMALL_ID=

# 현대몰(Hmall) 로그인 아이디 (선택) - 세션 만료로 재로그인이 필요할 때 아이디만 자동
# 입력됩니다. 비밀번호는 절대 저장/자동입력하지 않으며 매번 직접 입력해야 합니다
# (로그인 버튼을 자동으로 누르면 reCAPTCHA가 봇으로 판단해 로그인이 거부됩니다).
HMALL_ID=

# 더현대(hi.thehyundai.com) 로그인 아이디/비밀번호 (필수) - 다른 사이트와 달리 세션
# 만료 시 사람 개입 없이 완전 자동으로 재로그인하도록 만들어서, 비밀번호도
# 저장합니다(SSG와 동일한 방식 - reCAPTCHA 등에 막히지 않는 것을 확인했습니다).
THEHYUNDAI_ID=
THEHYUNDAI_PW=

# NS홈쇼핑(m.nsmall.com) 로그인 아이디/비밀번호 (필수) - 다른 사이트와 달리 세션
# 만료 시 사람 개입 없이 완전 자동으로 재로그인하도록 만들어서, 비밀번호도
# 저장합니다(SSG/더현대와 동일한 방식 - reCAPTCHA 등에 막히지 않는 것을 확인했습니다).
NSMALL_ID=
NSMALL_PW=

# 11번가(buy.11st.co.kr) 로그인 아이디/비밀번호 (필수) - 다른 사이트와 달리 세션
# 만료 시 사람 개입 없이 완전 자동으로 재로그인하도록 만들어서, 비밀번호도
# 저장합니다(SSG/더현대/NS홈쇼핑과 동일한 방식 - 캡차 등에 막히지 않는 것을
# 확인했습니다). 최초 1회 자동 로그인 후에는 auth/elevenst_state.json에 저장된
# 쿠키만으로 바로 조회됩니다.
ELEVENST_ID=
ELEVENST_PW=

# 옥션(escrow.auction.co.kr) 로그인 아이디/비밀번호 (필수) - 다른 사이트와 달리 세션
# 만료 시 사람 개입 없이 완전 자동으로 재로그인하도록 만들어서, 비밀번호도
# 저장합니다(SSG/더현대/NS홈쇼핑/11번가와 동일한 방식 - 캡차 등에 막히지 않는 것을
# 확인했습니다). 최초 1회 자동 로그인 후에는 auth/auction_state.json에 저장된
# 쿠키만으로 바로 조회됩니다.
AUCTION_ID=
AUCTION_PW=

# CJ온스타일(base.cjonstyle.com) 로그인 아이디 (선택) - 세션 만료로 재로그인이
# 필요할 때 아이디만 자동 입력됩니다. 비밀번호는 절대 저장/자동입력하지 않으며
# 매번 직접 입력해야 합니다 (로그인 폼에 Cloudflare "사람인지 확인" 체크박스가
# 있어 완전 자동 로그인이 불가능합니다).
CJONSTYLE_ID=

